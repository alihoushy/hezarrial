APP_NAME="هزار ریال"
APP_ENV=production
# Generate locally: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.hezarrial.ir

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran
# Needs Argon2id support in the host's PHP; cron/deploy.php checks it.
# Switch to bcrypt only before the first user is created.
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

APP_MAINTENANCE_DRIVER=file

# Daily files with a retention limit, so logs cannot fill the disk quota.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Shared hosts prefix names with the account user, e.g. cpuser_hezarrial.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Must match the site's domain, or logins fail with "419 Page Expired".
SESSION_DOMAIN=.hezarrial.ir
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No queue worker on shared hosting, and nothing is queued today.
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@hezarrial.ir"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Shared secret for POST /api/sms/ingest (iOS Shortcut). Empty = endpoint returns 503.
# Generate with: openssl rand -hex 32
SMS_INGEST_TOKEN=
SMS_INGEST_USER_ID=1
