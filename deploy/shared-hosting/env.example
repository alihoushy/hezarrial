APP_NAME="هزار ریال"
APP_ENV=production
# Generate locally: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.hezarrial.ir

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran
# Needs Argon2id support in the host's PHP; cron/deploy.php checks it.
# Switch to bcrypt only before the first user is created.
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

APP_MAINTENANCE_DRIVER=file

# Daily files with a retention limit, so logs cannot fill the disk quota.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Shared hosts prefix names with the account user, e.g. cpuser_hezarrial.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Must match the site's domain, or logins fail with "419 Page Expired".
SESSION_DOMAIN=.hezarrial.ir
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# "sync" sends mails and notifications during the request, so no worker is needed.
# To send them in the background instead, set "database" and add the schedule-run cron
# (docs/shared-hosting.md): it also runs the queue every minute.
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Outgoing mail from the hezarrial.ir mailbox (ask the host for the SMTP host and port).
# Until this is filled in, verification and password-reset mails go nowhere.
MAIL_MAILER=smtp
# smtps = implicit TLS (port 465); leave empty for STARTTLS (port 587).
MAIL_SCHEME=smtps
MAIL_HOST=mail.hezarrial.ir
MAIL_PORT=465
MAIL_USERNAME=no-reply@hezarrial.ir
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@hezarrial.ir"
MAIL_FROM_NAME="${APP_NAME}"
# Where messages from the website's contact form go (defaults to MAIL_FROM_ADDRESS).
# CONTACT_TO_ADDRESS=you@example.com

VITE_APP_NAME="${APP_NAME}"

# Outgoing SMS (reminders, mobile verification) through sms.ir. "log" only writes to the log.
# With "smsir", fill the API key from the sms.ir panel and your approved sender line number.
# SMSIR_VERIFY_TEMPLATE_ID is an optional verify (OTP) template with one parameter named Code.
SMS_DRIVER=log
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_VERIFY_TEMPLATE_ID=
# Most SMS notifications one user can receive per day (each one costs money).
SMS_DAILY_LIMIT_PER_USER=5

# Each user now creates personal SMS tokens in Settings > Bank SMS connection.
# These two are only the old single-user shortcut: while SMS_INGEST_TOKEN is set, that shared
# token still works for the user with SMS_INGEST_USER_ID. Remove both once the Shortcut uses
# a personal token.
SMS_INGEST_TOKEN=
SMS_INGEST_USER_ID=1
