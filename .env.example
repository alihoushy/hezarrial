APP_NAME="هزار ریال"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://www.hezarrial.ir

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran
HASH_DRIVER=argon2id

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hezarrial
DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.hezarrial.ir
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes mails to storage/logs (development). For real delivery use the
# hezarrial.ir mailbox: MAIL_MAILER=smtp plus the values below.
MAIL_MAILER=log
# smtps = implicit TLS (port 465); leave empty for STARTTLS (port 587).
MAIL_SCHEME=
MAIL_HOST=mail.hezarrial.ir
MAIL_PORT=465
MAIL_USERNAME=no-reply@hezarrial.ir
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@hezarrial.ir"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Outgoing SMS through sms.ir. "log" only writes to the log (development).
SMS_DRIVER=log
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_VERIFY_TEMPLATE_ID=
SMS_DAILY_LIMIT_PER_USER=5

# Deprecated: personal tokens are created in Settings > Bank SMS connection.
SMS_INGEST_TOKEN=
SMS_INGEST_USER_ID=1
